<Window x:Class="EasyFM350.Wpf.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EasyFM350.Wpf.UI"
        Title="EasyFM350" Width="980" Height="680" MinWidth="800" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource BorderBr}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource AccentBg}">
                        <TextBlock Text="FM" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="EasyFM350" Foreground="{StaticResource DimBr}" FontSize="12.5"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="—" Width="46" Height="36" Style="{StaticResource ChromeBtn}"
                            Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="▢" Width="46" Height="36" Style="{StaticResource ChromeBtn}"
                            Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="✕" Width="46" Height="36" Style="{StaticResource ChromeBtnClose}"
                            Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource BorderBr}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="8,10">
                        <RadioButton x:Name="NavDash" Style="{StaticResource NavBtn}" Content="Обзор" IsChecked="True"
                                     GroupName="nav" Click="OnNav" />
                        <RadioButton x:Name="NavBands" Style="{StaticResource NavBtn}" Content="Бэнды и режим"
                                     GroupName="nav" Click="OnNav" />
                        <RadioButton x:Name="NavApn" Style="{StaticResource NavBtn}" Content="APN" GroupName="nav"
                                     Click="OnNav" />
                        <RadioButton x:Name="NavNet" Style="{StaticResource NavBtn}" Content="Сеть" GroupName="nav"
                                     Click="OnNav" />
                        <RadioButton x:Name="NavDevice" Style="{StaticResource NavBtn}" Content="Модем" GroupName="nav"
                                     Click="OnNav" />
                        <RadioButton x:Name="NavLog" Style="{StaticResource NavBtn}" Content="Лог" GroupName="nav"
                                     Click="OnNav" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="14,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="RbSim" Content="SIM" GroupName="simslot" IsEnabled="False"
                                         Style="{StaticResource Pill}" Margin="0,0,6,0" Checked="OnSimSlotChecked"
                                         Click="OnSimPillClick" />
                            <RadioButton x:Name="RbEsim" Content="eSIM" GroupName="simslot" IsEnabled="False"
                                         Style="{StaticResource Pill}" Checked="OnSimSlotChecked"
                                         Click="OnSimPillClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnLang" Content="EN" Style="{StaticResource Btn}"
                                    Padding="10,4" Width="52" Click="OnLangSwitch" />
                            <Button x:Name="BtnPower" Style="{StaticResource Btn}"
                                    Padding="10,4" Width="76" Margin="8,0,0,0" Click="OnPower">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="PwrDot" Width="8" Height="8" Fill="{StaticResource Error}"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="PwrText" Text="OFF" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="PageHost" Margin="14,10,14,4">

                <Grid x:Name="PageDash">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TtlSignal" Foreground="{StaticResource DimBr}" FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtConnState" Grid.Column="1" Text="—" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DimBr}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtRsrp" Text="--" FontFamily="Consolas" FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBr}" />
                                <TextBlock x:Name="TxtRsrpUnit" Text="" Foreground="{StaticResource DimBr}"
                                           FontSize="13"
                                           VerticalAlignment="Bottom" Margin="6,0,0,7" />
                            </StackPanel>
                            <TextBlock x:Name="TxtGrid" Grid.Row="3" Grid.ColumnSpan="2"
                                       Foreground="{StaticResource DimBr}" FontSize="12"
                                       FontFamily="Consolas" Margin="0,8,0,8" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtCa" Grid.Row="4" Grid.ColumnSpan="2" Text="CA: --"
                                       Foreground="{StaticResource Accent}" FontSize="12.5" />
                            <TextBlock x:Name="TxtOperIp" Grid.Row="5" Grid.ColumnSpan="2" Text=""
                                       Foreground="{StaticResource DimBr}" FontSize="12"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TtlChart" Foreground="{StaticResource DimBr}" FontSize="12"
                                       FontWeight="SemiBold" />
                            <ui:LiveChart x:Name="Chart" Grid.Row="1" Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="PageBands" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                        <Grid>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TtlMode" Foreground="{StaticResource DimBr}" FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="RbModeAuto" Content="Авто" GroupName="mode" IsChecked="True"
                                                 Margin="0,0,6,0" Style="{StaticResource Pill}" Checked="OnModeChanged" />
                                    <RadioButton x:Name="RbMode5g4g" Content="5G+4G" GroupName="mode" Margin="0,0,6,0"
                                                 Style="{StaticResource Pill}" Checked="OnModeChanged" />
                                    <RadioButton x:Name="RbMode4g" Content="4G" GroupName="mode" Margin="0,0,6,0"
                                                 Style="{StaticResource Pill}" Checked="OnModeChanged" />
                                    <RadioButton x:Name="RbMode3g" Content="3G" GroupName="mode" Margin="0,0,6,0"
                                                 Style="{StaticResource Pill}" Checked="OnModeChanged" />
                                    <RadioButton x:Name="RbMode5gsa" Content="5G SA" GroupName="mode"
                                                 Style="{StaticResource Pill}" Checked="OnModeChanged" />
                                </StackPanel>

                                <ComboBox x:Name="Cmb5gOpt" Style="{StaticResource Combo}" Width="170"
                                          Margin="10,2,0,2" VerticalAlignment="Center"
                                          SelectionChanged="On5gOptChanged" />
                            </WrapPanel>
                            <Button x:Name="BtnRefreshBands" Style="{StaticResource Btn}" Padding="7,3"
                                    Margin="0,2,0,2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                    ToolTip="Refresh now" Click="OnRefreshBands">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TtlLte" FontSize="13" FontWeight="SemiBold" />
                                <ListBox x:Name="LstLte" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                         Margin="0,6,0,0"
                                         ItemContainerStyle="{StaticResource ListItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="OnBandPaintStart"
                                         PreviewMouseMove="OnBandPaintMove"
                                         PreviewMouseLeftButtonUp="OnBandPaintEnd"
                                         LostMouseCapture="OnBandPaintLostCapture">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TtlNr" FontSize="13" FontWeight="SemiBold" />
                                <ListBox x:Name="LstNr" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                         Margin="0,6,0,0"
                                         ItemContainerStyle="{StaticResource ListItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="OnBandPaintStart"
                                         PreviewMouseMove="OnBandPaintMove"
                                         PreviewMouseLeftButtonUp="OnBandPaintEnd"
                                         LostMouseCapture="OnBandPaintLostCapture">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="PageApn" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" MaxWidth="600" Padding="18,16" HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TtlApnSection" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="APN" Foreground="{StaticResource DimBr}" Margin="0,0,0,4" />
                                    <TextBox x:Name="InpApn" Style="{StaticResource Input}" Height="32" Padding="5,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="TtlApnProxy" Foreground="{StaticResource DimBr}"
                                               Margin="0,0,0,4" />
                                    <TextBox x:Name="InpProxyEndpoint" Style="{StaticResource Input}" Height="32"
                                             Padding="5,3" ToolTip="host:port" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TtlPdp" Foreground="{StaticResource DimBr}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="InpPdp" Style="{StaticResource Combo}" Height="32" Padding="8,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="TtlAuth" Foreground="{StaticResource DimBr}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="InpAuth" Style="{StaticResource Combo}" Height="32" Padding="8,3" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TtlUser" Foreground="{StaticResource DimBr}" Margin="0,0,0,4" />
                                    <TextBox x:Name="InpUser" Style="{StaticResource Input}" Height="32" Padding="8,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="TtlPass" Foreground="{StaticResource DimBr}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="InpPass" Style="{StaticResource InputPass}" Height="32"
                                                 Padding="8,3" />
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnApnWrite" Grid.Row="4" Content="Записать в модем"
                                    Style="{StaticResource Btn}"
                                    HorizontalAlignment="Right" Height="34" Margin="0,14,0,0" Padding="14,4"
                                    Click="OnApnWrite" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="PageNet" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TtlProxy" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtProxyState" Text="Состояние: Выключено"
                                               Foreground="{StaticResource DimBr}" Margin="0,4,0,0" FontSize="12" />
                                    <TextBlock x:Name="TxtProxyAddr" Text="" Foreground="{StaticResource Accent}"
                                               FontFamily="Consolas" Margin="0,2,0,0" FontSize="12.5" />
                                </StackPanel>
                                <ToggleButton x:Name="SwProxy" Grid.Column="1" VerticalAlignment="Center"
                                              Click="OnProxyToggle" Style="{StaticResource Switch}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TtlTun" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtTunState" Text="Состояние: Выключено"
                                               Foreground="{StaticResource DimBr}" Margin="0,4,0,0" FontSize="12" />
                                    <TextBlock x:Name="TxtTunWarn" Foreground="{StaticResource Warning}"
                                               FontSize="11.5" Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="SwTun" Grid.Column="1" VerticalAlignment="Center"
                                              Click="OnTunToggle" Style="{StaticResource Switch}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PageDevice" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="TtlDevice" Foreground="{StaticResource DimBr}" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="BtnRefreshInfo" Style="{StaticResource Btn}"
                                        HorizontalAlignment="Right"
                                        Padding="7,4" Click="OnRefreshInfo">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" Background="{StaticResource Surface2}"
                                    BorderBrush="{StaticResource BorderBr}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="InfoList" FontFamily="Consolas" FontSize="13" Padding="9,5">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Grid>
                                                    <Grid.ToolTip>
                                                        <ToolTip>
                                                            <ScrollViewer MaxHeight="400"
                                                                          VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{Binding Raw}" TextWrapping="Wrap"
                                                                           MaxWidth="520" />
                                                            </ScrollViewer>
                                                        </ToolTip>
                                                    </Grid.ToolTip>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="185" /><ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{StaticResource DimBr}" />

                                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}"
                                                             IsReadOnly="True" TextWrapping="Wrap" Padding="2,0"
                                                             Background="Transparent" BorderThickness="0"
                                                             HorizontalAlignment="Left"
                                                             FontFamily="Consolas" FontSize="13"
                                                             PreviewMouseLeftButtonUp="OnImeiClick">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource TextBr}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanEdit}"
                                                                            Value="True">
                                                                        <Setter Property="Cursor" Value="Hand" />
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding CanEdit}"
                                                                                    Value="True" />
                                                                            <Condition
                                                                                Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                                                Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background"
                                                                                Value="{StaticResource AccentBg}" />
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Accent}" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="PageLog" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="TxtLog" Style="{StaticResource Input}" AcceptsReturn="True"
                                     IsReadOnly="True" IsUndoEnabled="False"
                                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="ImeiOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B30F1115"
              MouseLeftButtonUp="OnImeiOverlayCancel" KeyDown="OnImeiOverlayKey">
            <Border Width="260" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,12"
                    Background="#E6161B22" BorderBrush="{StaticResource BorderBr}" BorderThickness="1"
                    CornerRadius="10"
                    MouseLeftButtonUp="OnImeiOverlayCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ImeiOverlayTitle" Foreground="{StaticResource DimBr}" FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="ImeiOverlayBox" Grid.Row="1" Style="{StaticResource Input}" Margin="0,8,0,0"
                             MaxLength="32"
                             PreviewTextInput="OnImeiOverlayText" DataObject.Pasting="OnImeiOverlayPaste" />
                    <TextBlock x:Name="ImeiOverlayHint" Grid.Row="2" Foreground="{StaticResource Error}" FontSize="11" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="Write" Style="{StaticResource Btn}" Padding="12,3" FontSize="12"
                                Click="OnImeiOverlayWrite" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="EsimOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B30F1115"
              MouseLeftButtonUp="OnEsimOverlayCancel" KeyDown="OnEsimOverlayKey">
            <Border Width="466" MaxHeight="672" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,14"
                    Background="#E6161B22" BorderBrush="{StaticResource BorderBr}" BorderThickness="1"
                    CornerRadius="10"
                    MouseLeftButtonUp="OnEsimOverlayCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="EsimTitle" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBr}" />
                            <TextBlock x:Name="EsimEid" Foreground="{StaticResource DimBr}" FontSize="11.5"
                                       FontFamily="Consolas" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource Surface2}"
                            BorderBrush="{StaticResource BorderBr}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="384">
                                <ItemsControl x:Name="EsimProfiles" FontSize="12.5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RowRoot" Margin="6,3" Padding="8,5" CornerRadius="6"
                                                    Cursor="Hand"
                                                    Tag="{Binding Iccid}" PreviewMouseLeftButtonUp="OnEsimProfileClick">
                                                <Grid>
                                                    <Border x:Name="HoverGlow" Background="{StaticResource AccentBg}"
                                                            CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="RowTitle" Text="{Binding Title}"
                                                                       Foreground="{StaticResource TextBr}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Iccid}"
                                                                       Foreground="{StaticResource DimBr}"
                                                                       FontSize="11" FontFamily="Consolas" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding DeleteText}"
                                                                Tag="{Binding Iccid}" Style="{StaticResource Btn}"
                                                                Padding="10,2" FontSize="11.5"
                                                                VerticalAlignment="Center" Click="OnEsimProfileDelete" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                    <Setter TargetName="RowRoot" Property="Background"
                                                            Value="{StaticResource AccentBg}" />
                                                    <Setter TargetName="RowTitle" Property="Foreground"
                                                            Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True" SourceName="RowRoot">
                                                    <Setter TargetName="HoverGlow" Property="Opacity" Value="0.48" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="EsimEmpty" Foreground="{StaticResource DimBr}" FontSize="12" Margin="10"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EsimCode" Style="{StaticResource Input}" Height="30" Padding="8,3"
                                 VerticalContentAlignment="Center" ToolTip="LPA:1$server$code" />
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Button x:Name="BtnEsimDownload" Style="{StaticResource Btn}" Padding="12,3"
                                    Click="OnEsimDownload" />
                            <ui:FillProgress x:Name="EsimWriteFill" IsHitTestVisible="False" Opacity="0.4"
                                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="EsimStatus" Foreground="{StaticResource DimBr}" FontSize="11.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>